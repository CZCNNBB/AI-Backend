# =============================================================================
# FastAPI 服务
# =============================================================================
FASTAPI_HOST="127.0.0.1"
FASTAPI_PORT=8090
LOG_LEVEL="INFO"

# Agent 访问本服务 FastMCP Streamable HTTP Endpoint 的地址；尾斜杠需要保留。
FASTMCP_PUBLIC_URL="http://127.0.0.1:8090/mcp/"


# =============================================================================
# PostgreSQL 业务数据库
# =============================================================================
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5433
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_me"
POSTGRES_DATABASE="career_ai"
POSTGRES_CONNECT_TIMEOUT=5


# =============================================================================
# LangGraph Checkpointer
# =============================================================================
# 支持 postgres、memory、none；持久化会话建议使用 postgres。
CHECKPOINTER_TYPE="postgres"
# Checkpoint 官方表所在的 PostgreSQL Schema。
CHECKPOINTER_POSTGRES_SCHEMA="agent"
# Checkpointer 异步连接池最小连接数。
CHECKPOINTER_POOL_MIN_SIZE=1
# Checkpointer 异步连接池最大连接数；建议先压测再逐步增加。
CHECKPOINTER_POOL_MAX_SIZE=5
# 等待池中可用连接的最长时间，单位为秒。
CHECKPOINTER_POOL_TIMEOUT=10
# 应用启动阶段等待最小连接数就绪的最长时间，单位为秒。
CHECKPOINTER_POOL_STARTUP_TIMEOUT=15
# 池内空闲连接的最长保留时间，单位为秒。
CHECKPOINTER_POOL_MAX_IDLE=300
# 单条连接的最长生命周期，单位为秒。
CHECKPOINTER_POOL_MAX_LIFETIME=1800


# =============================================================================
# LangSmith 可观测能力
# =============================================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_PROJECT="career-ai"


# =============================================================================
# 文件服务
# =============================================================================
# 留空时使用项目内 data/uploads；生产环境建议配置持久化绝对路径。
AI_BACKEND_UPLOAD_DIR=""
# 单次上传文件数上限。
FILE_MAX_FILES_PER_UPLOAD=10
# 单个文件大小上限，单位 MB。
FILE_MAX_SINGLE_FILE_MB=50
# 单次请求全部文件的总大小上限，单位 MB。
FILE_MAX_TOTAL_UPLOAD_MB=100
# 上传文件的流式写入块大小，单位 KB。
FILE_UPLOAD_CHUNK_KB=8
# 未指定行范围时，read_uploaded_file 默认读取的行数。
FILE_DEFAULT_READ_LINE_COUNT=200
# read_uploaded_file 单次返回内容的最大字符数。
FILE_MAX_READ_RESPONSE_CHARS=24000


# =============================================================================
# MinerU PDF 解析服务
# =============================================================================
# 每次 PDF 转换前调用 /health；不可用时回退 pymupdf4llm。
MINERU_ENABLED=true
MINERU_BASE_URL="http://127.0.0.1:18000"
# 单次健康检查超时，单位秒。
MINERU_HEALTH_TIMEOUT_SECONDS=5
# 单次提交、状态查询或结果查询的 HTTP 超时，单位秒。
MINERU_REQUEST_TIMEOUT_SECONDS=60
# MinerU 整个异步解析任务的最长等待时间，单位秒。
MINERU_TASK_TIMEOUT_SECONDS=600
# pending/processing 状态的轮询间隔，单位秒。
MINERU_POLL_INTERVAL_SECONDS=2


# =============================================================================
# Milvus 向量数据库
# =============================================================================
MILVUS_URI="http://127.0.0.1:19530"
MILVUS_TOKEN=""
MILVUS_DATABASE="career_ai"
MILVUS_CONNECT_TIMEOUT=8
MILVUS_WRITE_TIMEOUT=15
MILVUS_QUERY_TIMEOUT=15
MILVUS_NPROBE=10


# =============================================================================
# 知识库切片、检索与入库队列
# =============================================================================
SPLIT_DEFAULT_METHOD="recursive_character"
SPLIT_CHUNK_SIZE=1000
SPLIT_CHUNK_OVERLAP=200

KNOWLEDGE_STARTUP_HEALTH_CHECK_TIMEOUT=15
# 当前 FastAPI 进程内的知识入库 Worker 数；多实例使用 SKIP LOCKED 避免重复抢占。
KNOWLEDGE_INGESTION_WORKER_COUNT=1
KNOWLEDGE_INGESTION_POLL_INTERVAL_SECONDS=1
KNOWLEDGE_INGESTION_HEARTBEAT_SECONDS=10
KNOWLEDGE_INGESTION_STALE_SECONDS=60
KNOWLEDGE_INGESTION_RECOVERY_INTERVAL_SECONDS=30
KNOWLEDGE_INGESTION_MAX_RETRIES=3
KNOWLEDGE_INGESTION_RETRY_DELAY_SECONDS=5

# 检索保护参数；实际召回数量仍由 RetrievalConfig 和工具参数共同控制。
RETRIEVAL_METADATA_HEADERS_WEIGHT=0.6
RETRIEVAL_DOCUMENT_MAX_CHUNKS=5000


# =============================================================================
# Agent 运行阈值
# =============================================================================
# 工作上下文达到该 Token 数后触发总结；模板显式配置时以模板为准。
AGENT_CONTEXT_SUMMARY_TRIGGER_TOKENS=12000
# 总结后保留的近期消息数量；模板显式配置时以模板为准。
AGENT_CONTEXT_SUMMARY_KEEP_MESSAGES=20
# 单次发送给总结模型的最大 Token 数；模板显式配置时以模板为准。
AGENT_CONTEXT_SUMMARY_TRIM_TOKENS=4000
# LangGraph 单次 Agent 运行允许的最大图步骤数。
AGENT_RECURSION_LIMIT=50
# 工具异常返回给模型的最大字符数。
AGENT_TOOL_ERROR_MAX_LENGTH=500
